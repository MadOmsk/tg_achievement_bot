# Secrets and local state — never commit
.env
.env.*
!.env.example
!.env.test.example
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Anything taken out of a database, and the one-off scripts that take it.
# `backups/` is the only place such a file may live (see CLAUDE.md, Backups);
# the loose patterns below are the second line of defence, for the day
# somebody writes a dump into the repository root by accident — which is
# exactly what happened on 2026-09-14, with decrypted Xbox refresh tokens.
backups/
*backup*.json
*dump*.json
*tokens*.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Session logs — kept locally, decisions live in SPEC.md
history.md

# Runtime artefacts
logs/
*.pid
*.log

# Database copies, dumps, and the one-off scripts that make them (2026-09-14
# incident): they belong in backups/ and nowhere else, and none of it is ever
# committed. The three defensive patterns below are for the day somebody
# writes a dump into the repository root instead.
backups/
*backup*.json
*dump*.json
*tokens*.json
