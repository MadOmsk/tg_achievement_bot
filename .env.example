# Telegram
BOT_TOKEN=                      # the token from @BotFather
ADMIN_TG_IDS=                   # comma-separated numeric ids; access to /admin

# Microsoft / Azure — an app registered at portal.azure.com
# Scope: XboxLive.signin XboxLive.offline_access
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=             # https://your-domain/auth/callback
OAUTH_LISTEN_HOST=0.0.0.0
OAUTH_LISTEN_PORT=8080

# Telegram Mini App (optional). Public HTTPS URL of the SPA — BotFather
# Main Mini App / menu button / Cloudflare tunnel during local -Test -Web.
# Empty = Mini App entry points stay disabled; slash commands still work.
# Push notifications open it, so they need it too.
MINI_APP_URL=

# Encrypts refresh tokens and shared keys in the database
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Steam (optional — without it /connect_steam answers "not configured").
# No OAuth, one key for the whole bot: steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Anthropic (optional — only to translate achievement descriptions and guide
# tips into the missing language; no other LLM use). Key: console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube Data API v3 (optional — video guides on an achievement's page).
# Google Cloud console: enable "YouTube Data API v3", Credentials → API key.
YOUTUBE_API_KEY=

# Email sign-in (#162) — optional, but without a mail server the Mini App
# offers no email sign-in, and nobody new can sign up in a browser.
# SMTP_SECURITY: starttls (port 587), ssl (465) or none (a relay on this machine).
# SMTP_FROM is a bare address (no display name): it is also push's contact.
# Setting it up: docs/mail-setup.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Development only: codes go to the log instead of a mailbox. Never on a server.
EMAIL_LOG_CODES=false
# Development only: an address is taken as proved, with no code — anybody can
# sign in as anybody. Ignored when SMTP_HOST is set. Never on a server.
EMAIL_SKIP_CODE=false

# Poller intervals in seconds (SPEC 5.2, 5.3)
PRESENCE_INTERVAL_IN_GAME=60    # in a game
PRESENCE_INTERVAL_ONLINE=120    # online, not in a game
PRESENCE_INTERVAL_OFFLINE=300   # offline
PRESENCE_INTERVAL_IDLE=900      # offline for more than 2 hours
ACHIEVEMENT_POLL_INTERVAL=120   # achievement polls while in a game
TOKEN_REFRESH_MARGIN=300        # refresh a token that expires in less than N seconds

# Backfill concurrency (SPEC 5.6)
BACKFILL_CONCURRENCY=2

# Other
DB_PATH=data/bot.db
LOG_LEVEL=INFO
TZ=Europe/Moscow                # the starting value of app_settings.timezone

# Catching up after downtime (SPEC 5.8)
CATCHUP_PUBLISH_WINDOW_HOURS=24  # publish what was missed if not older than N hours
CATCHUP_MAX_TITLES=20            # games looked at in one catch-up
CATCHUP_INTERVAL_MINUTES=60      # how often each account is caught up while the bot runs
