# A second bot, for testing only (#52). Copy to `.env.test` and run:
#
#     $env:BOT_ENV_FILE = ".env.test"
#     .\.venv\Scripts\python.exe -m bot.main
#
# It takes its own database and its own lock file (which follows DB_PATH), so
# it can run beside the main bot. What you must NOT do is put the production
# bot's BOT_TOKEN here: two pollers on one token steal each other's updates
# (bot/lock.py).

# The second bot's token from @BotFather. Keep it here only: .env.* is in
# .gitignore, and it must not end up in any chat.
BOT_TOKEN=
ADMIN_TG_IDS=                   # a NUMERIC tg_id, not @username — the same as in .env

# A database of its own — otherwise test links and takeovers land in live data.
DB_PATH=data/test.db

# Xbox does not connect on the test bot: it needs a public HTTPS callback, and
# somebody else's Xbox cannot be taken over without their Microsoft password
# anyway. The values below are placeholders so the config loads; the port
# differs from 8080 so it does not clash with the main bot if that one runs.
AZURE_CLIENT_ID=unused-on-the-test-bot
AZURE_CLIENT_SECRET=unused-on-the-test-bot
OAUTH_REDIRECT_URL=https://example.invalid/auth/callback
OAUTH_LISTEN_HOST=127.0.0.1
OAUTH_LISTEN_PORT=8081

# An encryption key of its own, not production's: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Steam and PSN — what the test bot exists for: their accounts are taken over by
# typing somebody's nickname, with no authorization at all. The key and the NPSSO
# are entered not here but in the test bot's own admin panel ("🔑 Ключи платформ").
STEAM_API_KEY=
ANTHROPIC_API_KEY=

# Email sign-in (#162) — optional, but without a mail server the Mini App
# offers no email sign-in, and nobody new can sign up in a browser.
# SMTP_SECURITY: starttls (port 587), ssl (465) or none (a relay on this machine).
# SMTP_FROM is a bare address (no display name): it is also push's contact.
# Setting it up: docs/mail-setup.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Development only: codes go to the log instead of a mailbox. Never on a server.
EMAIL_LOG_CODES=false
# Development only: an address is taken as proved, with no code — anybody can
# sign in as anybody. Ignored when SMTP_HOST is set. Never on a server.
EMAIL_SKIP_CODE=false

LOG_LEVEL=INFO
