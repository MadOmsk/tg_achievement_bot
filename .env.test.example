# Второй бот — только для тестов (#52). Скопируй в `.env.test` и запускай:
#
#     $env:BOT_ENV_FILE = ".env.test"
#     .\.venv\Scripts\python.exe -m bot.main
#
# Он берёт свою базу и свой файл блокировки (тот следует за DB_PATH), так что
# может работать рядом с обычным ботом. Чего делать НЕЛЬЗЯ — ставить сюда тот
# же BOT_TOKEN, что у продового: два поллера на одном токене воруют друг у
# друга апдейты (bot/lock.py).

# Токен второго бота от @BotFather. Держи его только здесь: .env.* в
# .gitignore, и в переписку он попадать не должен.
BOT_TOKEN=
ADMIN_TG_IDS=                   # ЧИСЛОВОЙ tg_id, не @username — тот же, что в .env

# Своя база — иначе тестовые привязки и перехваты уедут в живые данные.
DB_PATH=data/test.db

# Xbox на тестовом боте не подключается: ему нужен публичный HTTPS-callback,
# а перехватить чужой Xbox всё равно нельзя без пароля от Microsoft. Значения
# ниже — заглушки, чтобы конфиг собрался; порт отличается от 8080, чтобы не
# столкнуться с основным ботом, если тот запущен.
AZURE_CLIENT_ID=unused-on-the-test-bot
AZURE_CLIENT_SECRET=unused-on-the-test-bot
OAUTH_REDIRECT_URL=https://example.invalid/auth/callback
OAUTH_LISTEN_HOST=127.0.0.1
OAUTH_LISTEN_PORT=8081

# Свой ключ шифрования, не продовый: сгенерировать
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Steam и PSN — то, ради чего тестовый бот и нужен: их аккаунт перехватывается
# вводом чужого ника, без всякой авторизации. Ключ и NPSSO вводятся не здесь,
# а в админке самого тестового бота («🔑 Ключи платформ»).
STEAM_API_KEY=
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO
