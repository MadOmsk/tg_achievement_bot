# User-visible OAuth validation errors (services/connect.py).
# OAuth connection service
connectservice-state-expired = That link has expired. Go back to the bot and press “Connect XBOX” again.
connectservice-account-owned = This XBOX account is already connected by another user of the bot.
connectservice-platform-cooldown = Re-connecting { $platform } is temporarily blocked (anti-abuse cooldown). Please try again in { $hours }h { $minutes }m.
